+    :root:not([data-theme="light"]) {
+      --bg: #121A24;
+      --bg-alt: #1B2531;
+      --ink: #F1EDE0;
+      --ink-soft: #AEB7C2;
+      --gold: #D7A748;
+      --teal: #4FA696;
+      --line: rgba(241,237,224,0.16);
+      --card-bg: #1C2733;
+      --card-line: rgba(241,237,224,0.14);
+    }
+  }
+  :root[data-theme="dark"] {
+    --bg: #121A24;
+    --bg-alt: #1B2531;
+    --ink: #F1EDE0;
+    --ink-soft: #AEB7C2;
+    --gold: #D7A748;
+    --teal: #4FA696;
